---
import Logo from './Logo.astro';
import ExternalLink from './ExternalLink.astro';
import { SITE, withBase } from '@/config/site';
import { COPY, pageLabel } from '@/i18n/content';
import { DEFAULT_LOCALE, localePath, PAGE_PATHS, type Locale, type PageKey } from '@/i18n/locales';

interface Props {
  locale?: Locale;
  page?: PageKey;
}
const { locale = DEFAULT_LOCALE, page = 'home' } = Astro.props;
const copy = COPY[locale];
const alternate: Locale = locale === 'en' ? 'he' : 'en';
const navigation = (Object.keys(PAGE_PATHS) as PageKey[]).filter((key) => key !== 'accessibility');
---

<header class="site-header">
  <div class="shell header-inner">
    <Logo locale={locale} />
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">{copy.navToggle}</span>
      <span></span><span></span><span></span>
    </button>
    <nav id="site-nav" aria-label={copy.navLabel}>
      {
        navigation.map((key) => (
          <a
            href={withBase(localePath(locale, key))}
            aria-current={page === key ? 'page' : undefined}
          >
            {pageLabel(locale, key)}
          </a>
        ))
      }
      <a
        class="language-switch"
        href={withBase(localePath(alternate, page))}
        lang={alternate}
        hreflang={alternate}
        aria-label={copy.languageSwitchLabel}>{copy.languageSwitch}</a
      >
      <ExternalLink class="github" href={SITE.repository} aria-label="Factor Library IL on GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path
            d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.57-.29-5.27-1.29-5.27-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18a10.95 10.95 0 0 1 5.76 0c2.19-1.49 3.15-1.18 3.15-1.18.63 1.58.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"
          ></path></svg
        >
      </ExternalLink>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('open', !open);
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.96);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .header-inner {
    min-height: 4.4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.65rem;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.93rem;
    font-weight: 570;
    padding-block: 1.55rem;
    position: relative;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }
  nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    background: var(--accent);
  }
  .github {
    padding-block: 0;
    display: flex;
  }
  .language-switch {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.38rem 0.7rem;
    color: var(--ink);
    line-height: 1;
  }
  .github svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: currentColor;
  }
  .nav-toggle {
    display: none;
    border: 0;
    background: none;
    padding: 0.5rem;
  }
  .nav-toggle span:not(.sr-only) {
    display: block;
    width: 1.35rem;
    height: 2px;
    margin: 4px;
    background: var(--ink);
  }
  /* Height condition catches a landscape phone: 844px wide but only 390px tall, where the
     desktop nav ate 19% of the screen. */
  @media (max-width: 48rem), (max-height: 30rem) {
    .header-inner {
      min-height: 3.25rem;
    }
    .nav-toggle {
      display: block;
    }
    nav {
      display: none;
      position: absolute;
      top: 4rem;
      inset-inline: 0;
      background: white;
      border-bottom: 1px solid var(--line);
      padding: 0.6rem 1.25rem 1rem;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    nav.open {
      display: flex;
    }
    nav a {
      padding: 0.75rem;
    }
    nav a[aria-current='page']::after {
      inset-inline: 0.75rem auto;
      width: 2.5rem;
    }
    .github {
      padding: 0.75rem;
    }
    .language-switch {
      align-self: flex-start;
      margin: 0.45rem 0.75rem;
      padding: 0.45rem 0.75rem;
    }
  }
</style>
